 "entries": [
  {
   "id": "EXE:6AA10",
   "kind": "code",
   "end": "2000",
   "jp": "セーブおねえさん：\nイエーイ！\nわたし、セーブおねえさんよ。",
   "en": ""
  },
  {
   "id": "EXE:6AA4E",
   "kind": "next",
   "end": "2000",
   "jp": "見てよ、このウエスタンルック！\nいかにも、せ・い・ぶ！　って\n感じでしょ。",
   "en": ""
  },
  {
   "id": "EXE:6AA9A",
   "kind": "next",
   "end": "2000",
   "jp": "ワタルくんたちがおとずれる、\n村やお城、洞窟などでゲームの\nデータをセーブできるわ。",
   "en": ""
  },
  {
   "id": "EXE:6AAF0",
   "kind": "next",
   "end": "2000",
   "jp": "わたしを見かけたら、いつでも\nこえをかけてね。\nセーブするのかどうかを聞くわ。",
   "en": ""
  },
  {
   "id": "EXE:6AB40",
   "kind": "next",
   "end": "2000",
   "jp": "おのぞみなら、\nセーブしてあげるわね。",
   "en": ""
  },
  {
   "id": "EXE:6AB68",
   "kind": "next",
   "end": "2000",
   "jp": "セーブがめんで、セーブする\nファイルを方向キーで選び、\n○ボタンで決定するだけよ。",
   "en": ""
  },
  {
   "id": "EXE:6ABBC",
   "kind": "next",
   "end": "3000",
   "jp": "メモリーカードをわすれずにね。",
   "en": ""
  },
  {
   "id": "EXE:6ABDC",
   "kind": "next",
   "end": "2000",
   "jp": "セーブおねえさん：\nイエーイ！",
   "en": ""
  },
  {
   "id": "EXE:6ABFC",
   "kind": "next",
   "end": "4000",
   "jp": "セーブしていく？\n　　　　　　　　はい\n　　　　　　　　いいえ",
   "en": ""
  },
  {
   "id": "EXE:6AC3C",
   "kind": "menu",
   "jp": "にセーブおねえさん：",
   "en": "",
   "end": "1000"
  },
  {
   "id": "EXE:6AC3E",
   "kind": "next",
   "end": "8000",
   "jp": "セーブおねえさん：\nセーブスタート！！",
   "en": ""
  },
  {
   "id": "EXE:6AC6A",
   "kind": "next",
   "end": "3000",
   "jp": "セーブおねえさん：\nそう・・・。\nあんまりムリをしないでね。",
   "en": ""
  },
  {
   "id": "EXE:77A84",
   "kind": "ptr",
   "end": "3000",
   "jp": "いらっしゃいませ。",
   "en": ""
  },
  {
   "id": "EXE:77A98",
   "kind": "next",
   "end": "2000",
   "jp": "いらっしゃいませ。",
   "en": ""
  },
  {
   "id": "EXE:77AAC",
   "kind": "next",
   "end": "5000",
   "jp": "せいさんします。",
   "en": ""
  },
  {
   "id": "EXE:77AC0",
   "kind": "ptr",
   "end": "2000",
   "jp": "いらっしゃいませ",
   "en": ""
  },
  {
   "id": "EXE:77AD2",
   "kind": "next",
   "end": "4000",
   "jp": "もんペットのなまえをかえますか？\n１．はい\n２．いいえ",
   "en": ""
  },
  {
   "id": "EXE:77B0E",
   "kind": "next",
   "end": "4000",
   "jp": "もんペットをすてますか？\n１．はい\n２．いいえ",
   "en": ""
  },
  {
   "id": "EXE:77B44",
   "kind": "next",
   "end": "3000",
   "jp": "いらっしゃーい・・・。\n買えるものがあるなら、買って\nいっておくれ。",
   "en": ""
  },
  {
   "id": "EXE:77BA0",
   "kind": "menu",
   "jp": "よろしいですか　　　はい　いいえおかねがたりません！！　　　　　もてる数が限界の装備があります。すでに、もっています。",
   "en": "",
   "tail": 5,
   "end": "0005"
  },
  {
   "id": "EXE:77C20",
   "kind": "menu",
   "jp": "おきゃくさん、ちょっと。",
   "en": "",
   "end": "1000"
  },
  {
   "id": "EXE:77C3A",
   "kind": "menu",
   "jp": "１．もどる",
   "en": "",
   "end": "1000"
  },
  {
   "id": "EXE:77C46",
   "kind": "menu",
   "jp": "２．でる",
   "en": "",
   "end": "4000"
  },
  {
   "id": "EXE:77C58",
   "kind": "menu",
   "jp": "もんペットを選んでください。　　なまえを入れてください。　　　　このなまえでよろしいですか？　　なまえへんこう",
   "en": "",
   "tail": 1,
   "end": "EOF"
  },
  {
