{
 "file": "FPRG/R02.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R02:11108",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おとこの子：\nボクこの村に生まれて良かったよ。",
   "en": ""
  },
  {
   "id": "R02:11138",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "だって、欲しい物を買うとお金が\nもらえちゃうんだもん。",
   "en": ""
  },
  {
   "id": "R02:11170",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "そうそう、【キャッシュバック】\nとか言うらしいよ。",
   "en": ""
  },
  {
   "id": "R02:111A4",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おとこの子：\n【キャッシュバック】に\nたよってばかりいる大人達に、",
   "en": ""
  },
  {
   "id": "R02:111E8",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "ボクらはガッカリしたんだ・・・。",
   "en": ""
  },
  {
   "id": "R02:1120A",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "だからボク達はここに集まって、\n「どうしようか？」と\n話し合っていたんだ。",
   "en": ""
  },
  {
   "id": "R02:11256",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "だけどね。",
   "en": ""
  },
  {
   "id": "R02:11262",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "ボク達子供の力じゃ、\nどうにもなりそうに\nないんだ・・・。",
   "en": ""
  },
  {
   "id": "R02:112A0",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おとこの子：\nだからボク達はここに集まって、\n「どうしようか？」と",
   "en": ""
  },
  {
   "id": "R02:112E4",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "話し合っていたんだ。",
   "en": ""
  },
  {
   "id": "R02:112FC",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おとこの子：\nだけどね。",
   "en": ""
  },
  {
   "id": "R02:11316",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "ボク達子供の力じゃ、\nどうにもなりそうに\nないんだ・・・。",
   "en": ""
  },
  {
   "id": "R02:11354",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おとこの子：\nボクの大好きなプロタンが、\n【キャッシュバック】でもらった",
   "en": ""
  },
  {
   "id": "R02:1139E",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "お金で、買えたんだ。\nいいでしょう。",
   "en": ""
  },
  {
   "id": "R02:113C4",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "でも、もんペットだけは\n【キャッシュバック】をして\nくれないから・・・",
   "en": ""
  },
  {
   "id": "R02:1140C",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "ほかのお店でもうけて、\nそのおカネでかってもらったんだ。",
   "en": ""
  },
  {
   "id": "R02:11448",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おとこの子：\n【カネワアルゾウ】ってヤツが\n悪いんだ！",
   "en": ""
  },
  {
   "id": "R02:11480",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "・・・だけど、\n本当は・・・・・・、\nいいヤツなのかもしれない。",
   "en": ""
  },
  {
   "id": "R02:114C4",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おとこの子：\nボクのともだちのおんなの子は、\n「おとうさんとたくさんあそべる」",
   "en": ""
  },
  {
   "id": "R02:11514",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "なんて、よろこんでいたけど、\nボクは、がんばって働いている\nおとうさんの方が好きだな。",
   "en": ""
  },
  {
   "id": "R02:1156C",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おんなの子：\n【カネワローン】っていう、\nおっきなビルが、",
   "en": ""
  },
  {
   "id": "R02:115A8",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "村の東の方にあるよ。",
   "en": ""
  },
  {
   "id": "R02:115C0",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "おんなの子：\n私、働きもしない大人になんて、\nぜったいならないんだから！",
   "en": ""
  },
  {
   "id": "R02:1160C",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "おんなの子：\n私は、普通のＯＬになるのが、\nユメなの。",
   "en": ""
  },
  {
   "id": "R02:11644",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おんなの子：\n子供にそんけいされる大人に\nなるためにがんばるわ！",
   "en": ""
  },
  {
   "id": "R02:11688",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おんなの子：\n最近、\nパパがいつもおうちにいるの。",
   "en": ""
  },
  {
   "id": "R02:116BC",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "だから、いっぱい、いっぱい、\nあそんでもらえるの。",
   "en": ""
  },
  {
   "id": "R02:116F0",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おんなの子：\nお金があふれているなんてっ！\nおかしいわよぉ！",
   "en": ""
  },
  {
   "id": "R02:1172E",
   "font": "R02",
   "kind": "next",
   "end": "4000",
   "jp": "そう思わない？\n１．はい　　　　　　\n２．いいえ　　　　　　",
   "en": ""
  },
  {
   "id": "R02:1176E",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おんなの子：\nでしょー！！\nそれでこそ、救世主様よぉ！",
   "en": ""
  },
  {
   "id": "R02:117A6",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おんなの子：\nなにぃー！？\nあなた、それでも救世主なのぉ！",
   "en": ""
  },
  {
   "id": "R02:117E4",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おんなの子：\nおーっほっほっ！！",
   "en": ""
  },
  {
   "id": "R02:11806",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "わたくしは決して、\nお金もちだからと言って、",
   "en": ""
  },
  {
   "id": "R02:11834",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "この方達とごいっしょ\nしているわけでは\nございませんのよ。",
   "en": ""
  },
  {
   "id": "R02:11870",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おんなの子：\nわたくしはビンボーというものに、\nあこがれているだけですわ。",
   "en": ""
  },
  {
   "id": "R02:118BC",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "・・・・・・？\nわたくし何かおかしなことを\n申しましたでしょうか？",
   "en": ""
  },
  {
   "id": "R02:11900",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おーっほっほっ！！\nそんなこと\nあるわけありませんわ。",
   "en": ""
  },
  {
   "id": "R02:11938",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おねえさん：\n【キャッシュバック】？",
   "en": ""
  },
  {
   "id": "R02:1195E",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "そのことなら、\n【カネワローン】に行くと、\n詳しいことがわかると思うわ。",
   "en": ""
  },
  {
   "id": "R02:119A8",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おねえさん：\nここから南にいくと、\n【子供達の森】よ。",
   "en": ""
  },
  {
   "id": "R02:119E0",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさん：\n【キャッシュバック】を\n行っている店のスポンサーは、",
   "en": ""
  },
  {
   "id": "R02:11A22",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "【カネワアルゾウ】ってヤツだ。",
   "en": ""
  },
  {
   "id": "R02:11A44",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おじさん：\n「あ！　あんな所に\nお金が落ちている！」",
   "en": ""
  },
  {
   "id": "R02:11A7A",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "・・・と、だれよりも先に、\nそこへ向かってダッシュする\nこともないんだよね～。",
   "en": ""
  },
  {
   "id": "R02:11ACA",
   "font": "R02",
   "kind": "next",
   "end": "4000",
   "jp": "なぜだかわかるかい？\n１．はい　　　　　　\n２．いいえ　　　　　　",
   "en": ""
  },
  {
   "id": "R02:11B10",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさん：\nそう！　【キャッシュバック】の\nおかげなんだね～。",
   "en": ""
  },
  {
   "id": "R02:11B50",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "でも、つまんない世の中になった\nもんだよね～。",
   "en": ""
  },
  {
   "id": "R02:11B80",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "だってさ～、お金をひろうときの\nあのスリリングな体験が\nできないんだもんさ～。あーあ。",
   "en": ""
  },
  {
   "id": "R02:11BD8",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "もちろん、働いてお金を\nもらったときのよろこびって\nヤツも感じられないんだよね～。",
   "en": ""
  },
  {
   "id": "R02:11C2C",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさん：\nう～ん。わからないか～。\nおじさん、がっかり・・・。",
   "en": ""
  },
  {
   "id": "R02:11C6E",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "それは、【キャッシュバック】の\nおかげらしいんだね～。",
   "en": ""
  },
  {
   "id": "R02:11CA6",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "まあ、世の中そう言うことに\nなっているみたいだけど、\nユメをもって生きていくんだね～。",
   "en": ""
  },
  {
   "id": "R02:11CFE",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "そう！　おじさんみたいに\nえがおで、がんばろうよ。\nはい、わらって、わらって！",
   "en": ""
  },
  {
   "id": "R02:11D50",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おばさん：\nコンビニって、スーパーと違って、\n買いすぎちゃうと",
   "en": ""
  },
  {
   "id": "R02:11D90",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "高くついちゃうのよね。",
   "en": ""
  },
  {
   "id": "R02:11DA8",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさん：\n村の入口のさかを下ったところに\nあるエレベーターって、",
   "en": ""
  },
  {
   "id": "R02:11DEC",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "地下につづいていたって話だけど、\n今は、カギがかけられているんだ。",
   "en": ""
  },
  {
   "id": "R02:11E30",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさん：\nよく来たね、ぼうや。\nおじさんのお話が、始まるよ。",
   "en": ""
  },
  {
   "id": "R02:11E70",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさんは今日のあさ、\nおべんとうのゴミを\nすてに行ったんだ。",
   "en": ""
  },
  {
   "id": "R02:11EB0",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "すると・・・、",
   "en": ""
  },
  {
   "id": "R02:11EC0",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "もんペットが近づいて来たんだ。\nだけど、中身は私がたべて\nしまったので無かったんだよ。",
   "en": ""
  },
  {
   "id": "R02:11F18",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "そこで、おじさんは、\nコンビニにおべんとうを\n買いに行ったんだねぇー。",
   "en": ""
  },
  {
   "id": "R02:11F60",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "すると、もんペットは、\nおじさんについて来るでは\nありませんか！",
   "en": ""
  },
  {
   "id": "R02:11FA2",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おじさん、本当におどろいたね。",
   "en": ""
  },
  {
   "id": "R02:11FC2",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "と、まあ、これでおじさんは、\nもんペットとなかよしに\nなったんだよ。",
   "en": ""
  },
  {
   "id": "R02:12008",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "そして、おじさんともんペットは\nその後、いっしょにおべんとうを\nたべたんだ。",
   "en": ""
  },
  {
   "id": "R02:12056",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "感動だろ？\n今まで生きてきた中で、\n一番幸せだったねぇー。",
   "en": ""
  },
  {
   "id": "R02:12094",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "カネワローンの人：\n私はねぇ、\nお金には目が無いよ。",
   "en": ""
  },
  {
   "id": "R02:120CC",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "カネワローンの人：\n【キャッシュバック】は、\nすばらしいシステムだと思うね。",
   "en": ""
  },
  {
   "id": "R02:1211C",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "カネワローンの人：\n【カネワローン】へようこそ。",
   "en": ""
  },
  {
   "id": "R02:12150",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "カネワローンの人：\n人はお金があればあるだけ、\nしあわせになれるんだよ。",
   "en": ""
  },
  {
   "id": "R02:1219A",
   "font": "R02",
   "kind": "next",
   "end": "4000",
   "jp": "そうは、思わんかね？\n１．はい　　　　　　\n２．いいえ　　　　　　",
   "en": ""
  },
  {
   "id": "R02:121E0",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "カネワローンの人：\nうん、うん。\nそうだろう。そうだろう。",
   "en": ""
  },
  {
   "id": "R02:1221C",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "カネワローンの人：\n何を言っとるんだね君はっ！\nわかっとらんよ。",
   "en": ""
  },
  {
   "id": "R02:1225E",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "まったく・・・。",
   "en": ""
  },
  {
   "id": "R02:12270",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "おねえさん：\n何だかわかんないけど・・・、",
   "en": ""
  },
  {
   "id": "R02:1229C",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "まあ・・・、\nたまには、体を動かさなきゃね。",
   "en": ""
  },
  {
   "id": "R02:122CC",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "おとこの子：\nわーい。わーい。",
   "en": ""
  },
  {
   "id": "R02:122EC",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おとこの子：\nへへーん。\nこっちだよー。",
   "en": ""
  },
  {
   "id": "R02:12318",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "おんなの子：\nオニさんこちら、手のなる方へ。",
   "en": ""
  },
  {
   "id": "R02:12348",
   "font": "R02",
   "kind": "ptr",
   "end": "3000",
   "jp": "おんなの子：\nうふふふっ。",
   "en": ""
  },
  {
   "id": "R02:12364",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "カネワローンの人：\nおろろ・・・！？\n目がまわる・・・。",
   "en": ""
  },
  {
   "id": "R02:123A0",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おねえさん：\nかーっ！　サケ好きの私には、\nありがたい話さ～。",
   "en": ""
  },
  {
   "id": "R02:123E0",
   "font": "R02",
   "kind": "next",
   "end": "2000",
   "jp": "ぼうや達も、のむか～い？",
   "en": ""
  },
  {
   "id": "R02:123FA",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "・・・って、あげないけどね。\nあ～っはっは～っ！",
   "en": ""
  },
  {
   "id": "R02:1242C",
   "font": "R02",
   "kind": "next",
   "end": "3000",
   "jp": "おねえさん：\n子供達に、サケのみの気もちは\nわからないさ・・・。",
   "en": ""
  },
  {
   "id": "R02:12470",
   "font": "R02",
   "kind": "ptr",
   "end": "2000",
   "jp": "おねえさん：\nお金って、次々にわいてくる\nありがたみの無いものだっけ？",
   "en": ""
  },
  {
   "id": "R02:124B8",
   "font": "R02",
   "kind": "next",
