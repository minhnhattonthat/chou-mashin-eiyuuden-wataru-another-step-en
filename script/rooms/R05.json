{
 "file": "FPRG/R05.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R05:11F32",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうあわぁ、\n何だかまぶしいところだね。",
   "en": ""
  },
  {
   "id": "R05:11F72",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n地中のわりには明るすぎるな。",
   "en": ""
  },
  {
   "id": "R05:11FAA",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n天井は明かりだらけですわ。\nまぶしくて当たり前ですわね。",
   "en": ""
  },
  {
   "id": "R05:11FFC",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうわぁー、ホントだぁ。",
   "en": ""
  },
  {
   "id": "R05:1202C",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nどうでもいいことだが、\nなぜ村の人たちは",
   "en": ""
  },
  {
   "id": "R05:12070",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サングラスをしているのだ？",
   "en": ""
  },
  {
   "id": "R05:1209A",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\n明かりを暗くすれば\nいいじゃない、ねぇ。",
   "en": ""
  },
  {
   "id": "R05:120F4",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nどうしたんですか？",
   "en": ""
  },
  {
   "id": "R05:12120",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "フーミン：\n救世主のワタルさんが、\nワットに捕まってしまったんです。",
   "en": ""
  },
  {
   "id": "R05:12174",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nえ・・・？　ボクが捕まった？",
   "en": ""
  },
  {
   "id": "R05:121AA",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "フーミン：\nは？",
   "en": ""
  },
  {
   "id": "R05:121CA",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあ、ボクは救世主ワタルさ。",
   "en": ""
  },
  {
   "id": "R05:121FE",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "フーミン：\nはぁ。",
   "en": ""
  },
  {
   "id": "R05:12220",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nボクが捕まったっていうのは、\nきっと気のせいだからさ、",
   "en": ""
  },
  {
   "id": "R05:12270",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "そんなに泣かないでよ。\nじゃぁねぇーん。",
   "en": ""
  },
  {
   "id": "R05:122AE",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n多分、そいつはニセモノだろう。",
   "en": ""
  },
  {
   "id": "R05:122E8",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nニセモノ？　どういうこと？",
   "en": ""
  },
  {
   "id": "R05:1231C",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n誰かが拙達の武勇伝を聞きつけて、\n大方マネでもしていたところを",
   "en": ""
  },
  {
   "id": "R05:12376",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "捕まってしまったんだろう・・・。\n運の悪いヤツ。",
   "en": ""
  },
  {
   "id": "R05:123B6",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそんな、運が悪いでは\nすまされませんわ。",
   "en": ""
  },
  {
   "id": "R05:123F8",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "わたくし達の代わりに\n捕まえられたなんて、\nかわいそうよ。",
   "en": ""
  },
  {
   "id": "R05:12442",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nサクヤの言うとおりだよ。",
   "en": ""
  },
  {
   "id": "R05:12474",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ここで放ったらかしたら、\nおじさんのファンが確実に滅るよ。",
   "en": ""
  },
  {
   "id": "R05:124C0",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそ、そうではなくって・・・。",
   "en": ""
  },
  {
   "id": "R05:124F6",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあと、救世主だったら\n助けなきゃいけないしねぇ。",
   "en": ""
  },
  {
   "id": "R05:12540",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nワタルさま？",
   "en": ""
  },
  {
   "id": "R05:12566",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "できれば、その理由を優先して\nいただきたかったのですが・・・。",
   "en": ""
  },
  {
   "id": "R05:125B4",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあは、あは、あは。やっぱり？",
   "en": ""
  },
  {
   "id": "R05:125EA",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nまぁ、お嬢もぼうやもそういう\nなら、助けに行った方が良いな。",
   "en": ""
  },
  {
   "id": "R05:12642",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nじゃっ、行こっ！",
   "en": ""
  },
  {
   "id": "R05:12672",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあそこに捕まってるんだね。",
   "en": ""
  },
  {
   "id": "R05:126A6",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nでも正面から\n「救世主くださーい。」という",
   "en": ""
  },
  {
   "id": "R05:126EA",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "わけにはいかなそうですわ。",
   "en": ""
  },
  {
   "id": "R05:12714",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nこの辺りに何か使えるものが\nあるんじゃないか？",
   "en": ""
  },
  {
   "id": "R05:12760",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nこれがあれば、万々歳よ。",
   "en": ""
  },
  {
   "id": "R05:12796",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nこっちに乗りな。",
   "en": ""
  },
  {
   "id": "R05:127C4",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nそらよっ！",
   "en": ""
  },
  {
   "id": "R05:127EC",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうわぁぁっ！",
   "en": ""
  },
  {
   "id": "R05:12812",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nこれならお城のトコロまでは\n行けますが・・・。",
   "en": ""
  },
  {
   "id": "R05:1285A",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\n名案だろ！",
   "en": ""
  },
  {
   "id": "R05:12898",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "Ｇワタル：\nキミたちだね、ボクらの代わりに\n捕まっちゃったのは？",
   "en": ""
  },
  {
   "id": "R05:128EA",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ＴＶワタル：\n代わり・・・？　キミは・・・？",
   "en": ""
  },
  {
   "id": "R05:12926",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "Ｇワタル：\nボク？　ああ、ボクは・・・。",
   "en": ""
  },
  {
   "id": "R05:1295E",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nワタルさま、早くしないと\n敵がやってきますわ。",
   "en": ""
  },
  {
   "id": "R05:129A8",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ＴＶワタル：\nえっ？　ワタルって。",
   "en": ""
  },
  {
   "id": "R05:129DC",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "Ｇワタル：\nおじさんっ！",
   "en": ""
  },
  {
   "id": "R05:12A06",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nおう！　みんなさがってな。\n×・の・字・斬・りぃーっ！",
   "en": ""
  },
  {
   "id": "R05:12A5A",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "シバラク：\n×の字斬り・・・？　はて？\nどこかで聞いたことが・・・。",
   "en": ""
  },
  {
   "id": "R05:12AAE",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\n早く逃げましょう。",
   "en": ""
  },
  {
   "id": "R05:12ADC",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ＴＶワタル：\n助かったよ。",
   "en": ""
  },
  {
   "id": "R05:12B06",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "Ｇワタル：\nまっ、これも\n救世主のつとめだしねっ。",
   "en": ""
  },
  {
   "id": "R05:12B48",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ＴＶワタル：\n救世主って、\nボクもそうなんだけど・・・。",
   "en": ""
  },
  {
   "id": "R05:12B90",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "Ｇワタル：\nまぁ、マネしてたのはもういい\nからさ。はやいとこ逃げ出そうよ。",
   "en": ""
  },
  {
   "id": "R05:12BEC",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ＴＶワタル：\nえっ！？\nマネなんかじゃないのに！",
   "en": ""
  },
  {
   "id": "R05:12C2E",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ヒミコ：\nほぇ？\nワタル同士でケンカしてるのか？",
   "en": ""
  },
  {
   "id": "R05:12C76",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "兵士：\nワット様、囚人共が脱走しました。",
   "en": ""
  },
  {
   "id": "R05:12CAE",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワット：\nにゃ、にゃにいっ！\n・・・ゆるさないデース！",
   "en": ""
  },
  {
   "id": "R05:12CF4",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "みんなペッチャンコにしてやる。",
   "en": ""
  },
  {
   "id": "R05:12D2A",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "シバラク：\n何と！",
   "en": ""
  },
  {
   "id": "R05:12D4C",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ではここは\n拙者達がいた頃より大昔の\n創界山だというのでござるか？",
   "en": ""
  },
  {
   "id": "R05:12D9E",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n・・・はい、\nみなさんのお話を聞いていると、",
   "en": ""
  },
  {
   "id": "R05:12DE4",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "どうもそうではないかと・・・。",
   "en": ""
  },
  {
   "id": "R05:12E12",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "シバラク：\nじゃあ拙者達は過去の創界山へ\n来ちゃったわけ？　ウソーん！",
   "en": ""
  },
  {
   "id": "R05:12E6A",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ヒミコ：\nわーいわーい、\nワタルとワタルでケンカ、ケンカ！",
   "en": ""
  },
  {
   "id": "R05:12EB4",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ＴＶワタル：\nマネじゃないって言ってるだろ！",
   "en": ""
  },
  {
   "id": "R05:12EF0",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "Ｇワタル：\n救世主だっていって\nとっつかまって、",
   "en": ""
  },
  {
   "id": "R05:12F30",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "どこがマネじゃないのさ！",
   "en": ""
  },
  {
   "id": "R05:12F58",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ＴＶワタル：\n・・・本当は、キミの方が\nマネしてるんじゃないの？",
   "en": ""
  },
  {
   "id": "R05:12FA8",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "Ｇワタル：\n何だって！？",
   "en": ""
  },
  {
   "id": "R05:12FD2",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "シバラク：\nあー、あいや\nシバラク、シバラクぅっ！",
   "en": ""
  },
  {
   "id": "R05:13014",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "今はどちらがどうと言っている\n場合ではござらん。",
   "en": ""
  },
  {
   "id": "R05:13054",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "それよりも、この世界から\n脱出することを考えなくては。",
   "en": ""
  },
  {
   "id": "R05:1309C",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "全員：\nうわぁっ。",
   "en": ""
  },
  {
   "id": "R05:130BE",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワット：\nよくもコケにしたですねぇ。",
   "en": ""
  },
  {
   "id": "R05:130F2",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "みんなペッチャンコにしてから\nレーザーで焼いてやるぅ。",
   "en": ""
  },
  {
   "id": "R05:13138",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "両ワタル：\nみんな下がって！\nりゅーじんまるーっ！",
   "en": ""
  },
  {
   "id": "R05:1317C",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ＴＶワタル：\nあれ？",
   "en": ""
  },
  {
   "id": "R05:131AE",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワット：\nは？\n私は一体なにをしていたのでスか？",
   "en": ""
  },
  {
   "id": "R05:131EE",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nほっ、取りあえずは\n何とかなったみたいだな。",
   "en": ""
  },
  {
   "id": "R05:13234",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ワット：\n明るい世界になるといいなぁ、",
   "en": ""
  },
  {
   "id": "R05:1326A",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "と思っていたら、\n何だかホントに\n明るくなって・・・。",
   "en": ""
  },
  {
   "id": "R05:132B0",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n明るい世界もいいが、\n明るすぎる世界はまずいぜぇ。",
   "en": ""
  },
  {
   "id": "R05:132FE",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\n何事もほどほどが\n大事ということですわ。",
   "en": ""
  },
  {
   "id": "R05:13346",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "シバラク：\nあぶないところをかたじけない。\n恩に着るでござる。",
   "en": ""
  },
  {
   "id": "R05:13394",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nまぁ、そんなよろしいですのよ。",
   "en": ""
  },
  {
   "id": "R05:133CC",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "どちらもちゃんとした救世主さま\nだったわけですし・・・。",
   "en": ""
  },
  {
   "id": "R05:13414",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nって、ぼうやたちは\n納得いかないようだがな・・・。",
   "en": ""
  },
  {
   "id": "R05:13464",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "Ｇワタル：\nキミの方がマネしてる！",
   "en": ""
  },
  {
   "id": "R05:13496",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "ＴＶワタル：\nいいや！　キミの方だ！",
   "en": ""
  },
  {
   "id": "R05:134CA",
   "font": "R04",
   "kind": "event",
   "end": "3000",
   "jp": "ヒミコ：\nにゃはは！\nマネっこしーあいーっ。",
   "en": ""
  },
  {
   "id": "R05:13508",
   "font": "R04",
   "kind": "event",
   "end": "2000",
   "jp": "シバラク：\nところで、これからお三方は\nどうするんでござるか？",
   "en": ""
  },
  {
   "id": "R05:13556",
