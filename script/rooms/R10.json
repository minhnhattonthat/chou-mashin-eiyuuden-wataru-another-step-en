{
 "file": "FPRG/R10.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R10:01638",
   "font": "R0A",
   "kind": "event",
   "end": "E000",
   "jp": "レ　",
   "en": ""
  },
  {
   "id": "R10:0C42A",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nこの辺りの人は、体を鍛えるのが\n好きなのかなぁ。",
   "en": ""
  },
  {
   "id": "R10:0C474",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nん？　どうした？",
   "en": ""
  },
  {
   "id": "R10:0C4A0",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nだってあの建物に、",
   "en": ""
  },
  {
   "id": "R10:0C4CC",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n大きな建物でございますわねぇ。",
   "en": ""
  },
  {
   "id": "R10:0C504",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nあれがどうかしたか？",
   "en": ""
  },
  {
   "id": "R10:0C534",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\n【アスレチックジム】って\n書いてある・・・。",
   "en": ""
  },
  {
   "id": "R10:0C590",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nこの【アスレチックジム】は、\n何だか無理矢理体を",
   "en": ""
  },
  {
   "id": "R10:0C5DA",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "鍛えさせられてるような\n人達ばっかりだね。",
   "en": ""
  },
  {
   "id": "R10:0C614",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n何だか・・・と言うよりは、\nそのもののようだなぁ。",
   "en": ""
  },
  {
   "id": "R10:0C662",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n先ほどの【ワルリリス】という\nものが、無理矢理みんなに",
   "en": ""
  },
  {
   "id": "R10:0C6B2",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "体を鍛えさせているのでは\nないでしょうか？",
   "en": ""
  },
  {
   "id": "R10:0C6EE",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n話の感じからすると、\nそうだよね。",
   "en": ""
  },
  {
   "id": "R10:0C72A",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nそういう時は、本人に\n聞いてみるのが一番ってものよ。",
   "en": ""
  },
  {
   "id": "R10:0C77C",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nじゃっ、聞いてみよう！",
   "en": ""
  },
  {
   "id": "R10:0C7C4",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nえーっ？\nこの人が【ワルリリス】！？",
   "en": ""
  },
  {
   "id": "R10:0C804",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nん？　なんだお前達は？",
   "en": ""
  },
  {
   "id": "R10:0C838",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n無理矢理体を鍛えさせて\nどうするのかなぁーっと思って。",
   "en": ""
  },
  {
   "id": "R10:0C888",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nいくら健康的なことでも、\n無理強いはよくないと思いますわ。",
   "en": ""
  },
  {
   "id": "R10:0C8DE",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nなんだと？\n無理強いなんぞしていないぞ。",
   "en": ""
  },
  {
   "id": "R10:0C924",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ただ、オレはオレの\n嫌いな体型をしているヤツが\n嫌いなだけだ。",
   "en": ""
  },
  {
   "id": "R10:0C974",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nお前が好きな体型を\nしていない人や、お年寄りを",
   "en": ""
  },
  {
   "id": "R10:0C9BC",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "変な穴に落っことすことは、\nもうわかってるんだぞ！\nいい加減白状しろ！",
   "en": ""
  },
  {
   "id": "R10:0CA12",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\n落とし穴の中では、\nオレの好む体型になりたい村人が",
   "en": ""
  },
  {
   "id": "R10:0CA62",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "努力を重ねているだけだ。\n酷（ひど）いこととは心外だな。",
   "en": ""
  },
  {
   "id": "R10:0CAAA",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそれを強要するのが\n酷いことなんですのよ。",
   "en": ""
  },
  {
   "id": "R10:0CAEE",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nそうか・・・。",
   "en": ""
  },
  {
   "id": "R10:0CB1A",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "それでは酷いことなのかどうか、\n自分の目で\n確かめてみるとよかろう・・・。",
   "en": ""
  },
  {
   "id": "R10:0CB76",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "大体、貴様らは、\nオレの大嫌いな体型を\nしているしな・・・。",
   "en": ""
  },
  {
   "id": "R10:0CBC2",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ガキにひょろひょろオヤジ、\n幼児体型の女ときている。",
   "en": ""
  },
  {
   "id": "R10:0CC08",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nオ、オヤジぃぃぃぃぃっっっ！！！",
   "en": ""
  },
  {
   "id": "R10:0CC44",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nよ、よ、幼児体型ぃぃぃぃっっっ！",
   "en": ""
  },
  {
   "id": "R10:0CC7E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nおい！",
   "en": ""
  },
  {
   "id": "R10:0CCA2",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "こいつらを例のところに\nつれていけ！！",
   "en": ""
  },
  {
   "id": "R10:0CCDA",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nな、何をするんだ！？",
   "en": ""
  },
  {
   "id": "R10:0CD0E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nいったい何のつもりだ！",
   "en": ""
  },
  {
   "id": "R10:0CD3E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nこの建物の中にいる以上、\nお前らにも",
   "en": ""
  },
  {
   "id": "R10:0CD80",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "オレ好みの体型になってもらう。",
   "en": ""
  },
  {
   "id": "R10:0CDAE",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n何だって！？",
   "en": ""
  },
  {
   "id": "R10:0CDD4",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nオ、オヤジ・・・。",
   "en": ""
  },
  {
   "id": "R10:0CE02",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nよ、幼児体型・・・。",
   "en": ""
  },
  {
   "id": "R10:0CE32",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nや、やめろ！\nこのオトコオンナぁ！",
   "en": ""
  },
  {
   "id": "R10:0CE6E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nおとこで結構！\n漢と書いてオトコと読む！",
   "en": ""
  },
  {
   "id": "R10:0CEB4",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "オレにとっては、\n最高の誉（ほ）め言葉だ。",
   "en": ""
  },
  {
   "id": "R10:0CEF0",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワルリリス：\nやれ！",
   "en": ""
  },
  {
   "id": "R10:0CF16",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタルたち：\nうわぁ～っ！",
   "en": ""
  },
  {
   "id": "R10:0CF58",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nむむ、これはちょうど良さそうな\nお湯だ。",
   "en": ""
  },
  {
   "id": "R10:0CF9C",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ついつかって行きたくなるなぁ。",
   "en": ""
  },
  {
   "id": "R10:0CFCA",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nだめよ！\n元のところに戻らなきゃ！！",
   "en": ""
  },
  {
   "id": "R10:0D008",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nう～ん、見れば見るほど\n入って行きたくなる。",
   "en": ""
  },
  {
   "id": "R10:0D052",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n温泉に入ることより\n重要なことがあるじゃないか。",
   "en": ""
  },
  {
   "id": "R10:0D09C",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "今はダメだよ。",
   "en": ""
  },
  {
   "id": "R10:0D0BC",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nワタル殿、\nちょっとだけ、な？",
   "en": ""
  },
  {
   "id": "R10:0D0F6",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nダメだって言ってるのに・・・。",
   "en": ""
  },
  {
   "id": "R10:0D12E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nでも温泉は美容に\nいいって言うわよね・・・。",
   "en": ""
  },
  {
   "id": "R10:0D174",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nそうそう、",
   "en": ""
  },
  {
   "id": "R10:0D19A",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "「喉元過ぎれば熱さ忘れる」\nと言うではないか。",
   "en": ""
  },
  {
   "id": "R10:0D1D8",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nちょっとちょっと２人とも！",
   "en": ""
  },
  {
   "id": "R10:0D20C",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ボク達には\nやらなきゃいけない事が\nあるじゃないか。",
   "en": ""
  },
  {
   "id": "R10:0D252",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nせ、拙は、\nもうがまんならんでござるよ～。",
   "en": ""
  },
  {
   "id": "R10:0D298",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n入っちゃおうか？",
   "en": ""
  },
  {
   "id": "R10:0D2C2",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nち、ちょっと２人ともー。\n・・・でも気持ちよさそうだなぁ。",
   "en": ""
  },
  {
   "id": "R10:0D318",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R10:0D330",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R10:0D348",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R10:0D362",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワルリリス：\n一体何をしているんだお前達は！！",
   "en": ""
  },
  {
   "id": "R10:0D3B8",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nあ～、\n【ワルリリス】ではないか・・・。",
   "en": ""
  },
  {
   "id": "R10:0D3FC",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあ～、ほんとだ～。",
   "en": ""
  },
  {
   "id": "R10:0D428",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\n部下から報告を受けて\n様子を見に来てみれば、",
   "en": ""
  },
  {
   "id": "R10:0D472",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ブクブクと太りおって・・・。",
   "en": ""
  },
  {
   "id": "R10:0D49E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "どうせ、温泉につかって\nそのままどうでも良くなって\nしまったのだろう！",
   "en": ""
  },
  {
   "id": "R10:0D4F4",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタルたち：\nギク！",
   "en": ""
  },
  {
   "id": "R10:0D518",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\n言い返せまい。",
   "en": ""
  },
  {
   "id": "R10:0D544",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nうぐぐ・・・。",
   "en": ""
  },
  {
   "id": "R10:0D56E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n・・・クックック。",
   "en": ""
  },
  {
   "id": "R10:0D59C",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "「飛んで火に入る蝉の音」\nとはこの事よ。",
   "en": ""
  },
  {
   "id": "R10:0D5D4",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\n何！？",
   "en": ""
  },
  {
   "id": "R10:0D5F8",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nえ！？　まちがってない？",
   "en": ""
  },
  {
   "id": "R10:0D62A",
   "font": "R0A",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nえ！？　・・・ことわざ。",
   "en": ""
  },
  {
   "id": "R10:0D65E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n拙達がわざわざ太ったのは、\nお主をおびきよせるため！",
   "en": ""
  },
  {
   "id": "R10:0D6AE",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "お主は見事にひっかかって\nノコノコやって来た、\nと言うわけだ。",
   "en": ""
  },
  {
   "id": "R10:0D6FC",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそ、そうだったんだ！",
   "en": ""
  },
  {
   "id": "R10:0D72A",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "でも、そのわりには\n温泉に嬉しそうに\n飛び込んだような・・・。",
   "en": ""
  },
  {
   "id": "R10:0D778",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそのわりには、いち早く\n温泉に飛び込んでましたわ。",
   "en": ""
  },
  {
   "id": "R10:0D7C4",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n「将を射んと欲すれば、\nまず味方から」と言うではないか。",
   "en": ""
  },
  {
   "id": "R10:0D818",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそれを言うなら「敵を欺（あざむ）\nくには、まず味方から」ですわ。",
   "en": ""
  },
  {
   "id": "R10:0D872",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "口からでまかせを\nおっしゃらないで下さい。",
   "en": ""
  },
  {
   "id": "R10:0D8AC",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリリス：\nで、おびき寄せて\nどうするつもりだったのだ？",
   "en": ""
  },
  {
   "id": "R10:0D8F6",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nは？　え、いや、あの・・・。",
   "en": ""
  },
  {
   "id": "R10:0D92E",
   "font": "R0A",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n・・・。",
   "en": ""
  },
  {
