{
 "file": "FPRG/R01.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R01:008F0",
   "font": "R00",
   "kind": "event",
   "end": "E000",
   "jp": "レ　",
   "en": ""
  },
  {
   "id": "R01:0E762",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうぅー、お腹がすいたなぁー。",
   "en": ""
  },
  {
   "id": "R01:0E798",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nだらしないな、ぼうや。",
   "en": ""
  },
  {
   "id": "R01:0E7CA",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそういうおじさまだって、かなり\nお腹がすいているようですわ。",
   "en": ""
  },
  {
   "id": "R01:0E820",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nうっ・・・。\nそういうお嬢だって・・・！",
   "en": ""
  },
  {
   "id": "R01:0E864",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "いや、しゃべると腹が滅る。",
   "en": ""
  },
  {
   "id": "R01:0E88E",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nどこかに食べ物でも落ちてない\nかなぁ・・・。",
   "en": ""
  },
  {
   "id": "R01:0E8D4",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R01:0E8EC",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R01:0E904",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R01:0E91C",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nあっ、あれは村ではないか！？",
   "en": ""
  },
  {
   "id": "R01:0E954",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nホントだ！　行こう行こう！！",
   "en": ""
  },
  {
   "id": "R01:0E98E",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうっわぁーっ！！　村だ村だぁ！",
   "en": ""
  },
  {
   "id": "R01:0E9C6",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nフッ。まるで「九死に一生を得た」\nような気分だぜ！",
   "en": ""
  },
  {
   "id": "R01:0EA14",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\n良かったですわね、\nワタルさま、おじさま。",
   "en": ""
  },
  {
   "id": "R01:0EA5A",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nあっれぇ？",
   "en": ""
  },
  {
   "id": "R01:0EA80",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nどうかなさいましたか？",
   "en": ""
  },
  {
   "id": "R01:0EAB0",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nいや、別にね、どうもしないんだ\nけど・・・。",
   "en": ""
  },
  {
   "id": "R01:0EAF6",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "何かこう・・・\nコンビニばっかりみたいな気が\nするんだよなぁ。",
   "en": ""
  },
  {
   "id": "R01:0EB46",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nいやいやぁ、拙には、ぜーんぜん\nおかしいところなどわからんなぁ。",
   "en": ""
  },
  {
   "id": "R01:0EBA2",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "それはお主がぼうやだから、では\nないのか？",
   "en": ""
  },
  {
   "id": "R01:0EBDE",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nボク、ぼうやじゃないやいっ！\nそんなこと言ったら、",
   "en": ""
  },
  {
   "id": "R01:0EC2A",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴトだって、\nおじさんじゃないかっ！",
   "en": ""
  },
  {
   "id": "R01:0EC64",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nぬ、にゃにぃぃっっ！",
   "en": ""
  },
  {
   "id": "R01:0EC96",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nまぁまぁ。ぼうやはぼうや、\nおじさんはおじさん、",
   "en": ""
  },
  {
   "id": "R01:0ECE0",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ということでよろしいじゃない\nですか。",
   "en": ""
  },
  {
   "id": "R01:0ED18",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタルとアラゴト：\nうっ、うぐっ！",
   "en": ""
  },
  {
   "id": "R01:0ED4A",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nさぁ参りましょう、お二人とも。",
   "en": ""
  },
  {
   "id": "R01:0ED9C",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おんなの子：\nお弁当はいりませんかー？\nただ今、無料で配布中でーす！",
   "en": ""
  },
  {
   "id": "R01:0EDF0",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nおっ！？　どうやらあそこで\n配っているようだ。",
   "en": ""
  },
  {
   "id": "R01:0EE3A",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nホントだぁー、よしっ行こう！",
   "en": ""
  },
  {
   "id": "R01:0EE72",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "おんなの子：\nありがとうございましたぁーっ！",
   "en": ""
  },
  {
   "id": "R01:0EEB0",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nあのぉ・・・。\nつかぬことをお聞きしますが？",
   "en": ""
  },
  {
   "id": "R01:0EEF6",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おんなの子：\nはい、なんでしょう？",
   "en": ""
  },
  {
   "id": "R01:0EF28",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nなぜ、\nこのお弁当は無料なのでしょう？",
   "en": ""
  },
  {
   "id": "R01:0EF68",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "見た所手作りのようですが、\n非常に手間やお金がかかると思う\nのですが・・・。",
   "en": ""
  },
  {
   "id": "R01:0EFC4",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おんなの子：\nいや、私は、",
   "en": ""
  },
  {
   "id": "R01:0EFEE",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "私の作ったお弁当をみんなに\n食べてもらいたいだけなんです。",
   "en": ""
  },
  {
   "id": "R01:0F038",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "だから、別に手間やお金とか、\nそういう苦労は気にならないん\nです。",
   "en": ""
  },
  {
   "id": "R01:0F08A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "例えていうなら、ケーキは作る\nときも食べるときも楽しい！\nようなものです。",
   "en": ""
  },
  {
   "id": "R01:0F0E4",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nほーっ！　今時にしては\n立派な心がけだ。感心感心。",
   "en": ""
  },
  {
   "id": "R01:0F132",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそうですか・・・。\nありがとうございました。",
   "en": ""
  },
  {
   "id": "R01:0F178",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "お弁当もいただきましたし、\nさ、参りましょう。",
   "en": ""
  },
  {
   "id": "R01:0F1B8",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nいやぁ、良かった良かった。\n「腹が滅ってはウシもあるかぬ」",
   "en": ""
  },
  {
   "id": "R01:0F20E",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ということわざもあることだし、\nさっそく食べるとしよう！",
   "en": ""
  },
  {
   "id": "R01:0F256",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nそうそう！　腹が滅っては・・・。\nそんなんだったっけ？",
   "en": ""
  },
  {
   "id": "R01:0F2AE",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nはぁー、食った食ったぁ。",
   "en": ""
  },
  {
   "id": "R01:0F2E2",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "人間、腹がふくれると\n眠くなってくるでござるよ・・・。",
   "en": ""
  },
  {
   "id": "R01:0F32A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nお、おじさん！　ちょっと！\nアラゴトのおじさん！",
   "en": ""
  },
  {
   "id": "R01:0F374",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "・・・ねちゃったよ。",
   "en": ""
  },
  {
   "id": "R01:0F39A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nおほほほほ、おじさまは全く\nウシやブタのようですわね。",
   "en": ""
  },
  {
   "id": "R01:0F3EA",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nサ、サクヤって・・・、\nすごいこと言うね・・・。",
   "en": ""
  },
  {
   "id": "R01:0F434",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nおほほほほほ。",
   "en": ""
  },
  {
   "id": "R01:0F45C",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nねぇ、どうしようか？",
   "en": ""
  },
  {
   "id": "R01:0F48A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそうですわねぇ・・・。",
   "en": ""
  },
  {
   "id": "R01:0F4BA",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴトおじさまは、一度寝て\nしまうと、なかなか目が覚めない\nですから・・・。",
   "en": ""
  },
  {
   "id": "R01:0F518",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n・・・置いてっちゃおうか？",
   "en": ""
  },
  {
   "id": "R01:0F54C",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nそうですわね。",
   "en": ""
  },
  {
   "id": "R01:0F58C",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nワタルさま、わたくし何だか頭が\nフラフラしますわ。",
   "en": ""
  },
  {
   "id": "R01:0F5DA",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n大丈夫？　サクヤ。どこかで\n休んだ方がいいんじゃない？",
   "en": ""
  },
  {
   "id": "R01:0F62A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nでは・・・。\n村の入り口に宿屋がありましたわ。",
   "en": ""
  },
  {
   "id": "R01:0F672",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nじゃあ、そこに行こう！",
   "en": ""
  },
  {
   "id": "R01:0F6AA",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nじゃあボク、薬を探してくるよ。",
   "en": ""
  },
  {
   "id": "R01:0F6E2",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nお願いしますわ、ワタルさま。",
   "en": ""
  },
  {
   "id": "R01:0F730",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "エビフライになっちゃったよーん！",
   "en": ""
  },
  {
   "id": "R01:0F762",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nぅわわっ！\nなんじゃこりゃぁーっ？",
   "en": ""
  },
  {
   "id": "R01:0F7A0",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nうわっ、な、なにするんだよーっ！",
   "en": ""
  },
  {
   "id": "R01:0F80C",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "えびフライ：\nわあぁぁっっ！！",
   "en": ""
  },
  {
   "id": "R01:0F83A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nな、なんだぁ、ここ！？",
   "en": ""
  },
  {
   "id": "R01:0F86A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nよぉー、ぼうや。お主もきたか。",
   "en": ""
  },
  {
   "id": "R01:0F8A4",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあーっ、アラゴトのおじさん！！",
   "en": ""
  },
  {
   "id": "R01:0F8DC",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n弁当を食べて、気持ちよく寝て\nいたら、いつのまにかこんな所に",
   "en": ""
  },
  {
   "id": "R01:0F934",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おさまっちまった。\nこれぞ「油断大敵あめアラレ」\nってヤツだな、わっはっは！",
   "en": ""
  },
  {
   "id": "R01:0F990",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nいったい全体！\nこれはどういうことなの！？",
   "en": ""
  },
  {
   "id": "R01:0F9D4",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nこれはすべて・・・\nおべんと娘の仕組んだことですわ。",
   "en": ""
  },
  {
   "id": "R01:0FA22",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nサクヤまで！！",
   "en": ""
  },
  {
   "id": "R01:0FA4A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n私たちが公園でいただいたお弁当\nには、人間をお弁当の具にする、",
   "en": ""
  },
  {
   "id": "R01:0FAA2",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "悪い魔法がかけてあったんですわ。",
   "en": ""
  },
  {
   "id": "R01:0FAD2",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おべんと娘：\n悪い魔法なんて人聞きが悪い。",
   "en": ""
  },
  {
   "id": "R01:0FB0C",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "私はみなさんがオイシイお弁当に\nなるための、おまじないをした\nまでです。",
   "en": ""
  },
  {
   "id": "R01:0FB64",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "そうですねぇ、あまーいスイカに\nしょっぱいお塩をかけるともっと\n甘くなる、ようなものでしょうか。",
   "en": ""
  },
  {
   "id": "R01:0FBD4",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあーっ、キミはさっきの！！",
   "en": ""
  },
  {
   "id": "R01:0FC08",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おべんと娘：\nうふふっ。こうなると\n救世主ワタルも形無しですね。",
   "en": ""
  },
  {
   "id": "R01:0FC58",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nえっ、ボクを知ってるの？",
   "en": ""
  },
  {
   "id": "R01:0FC8A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "おべんと娘：\n救世主ワタルと言ったらアタシや\nワルモンダー様の行く手をはばむ",
   "en": ""
  },
  {
   "id": "R01:0FCE6",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "伝説の勇者！",
   "en": ""
  },
  {
   "id": "R01:0FD02",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "それが創界山にあらわれたという\nことは、「梅干しとうなぎの食べ\nあわせが悪い」と、おなじくらい",
   "en": ""
  },
  {
   "id": "R01:0FD70",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "誰でも知っていることです！",
   "en": ""
  },
  {
   "id": "R01:0FD9A",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nええっ！？　そうなの？",
   "en": ""
  },
  {
   "id": "R01:0FDCA",
   "font": "R00",
   "kind": "event",
