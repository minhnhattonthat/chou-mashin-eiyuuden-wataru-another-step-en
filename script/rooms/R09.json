{
 "file": "FPRG/R09.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R09:1011A",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n景気のいい村のようだな。",
   "en": ""
  },
  {
   "id": "R09:1014E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nわぁ、花火がたくさん\n上がっていますわ。",
   "en": ""
  },
  {
   "id": "R09:10190",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\n運動会でもやってるのかなぁ。",
   "en": ""
  },
  {
   "id": "R09:101DC",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n困りましたわね・・・。",
   "en": ""
  },
  {
   "id": "R09:1020C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "これでは村の方々と\nお話もできませんわ。",
   "en": ""
  },
  {
   "id": "R09:10244",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうーん。金メダルを持っていれば\nいいんだけど・・・。",
   "en": ""
  },
  {
   "id": "R09:10292",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nでも、金メダルなんて、そうそう\n手に入るモノではありませんわ。",
   "en": ""
  },
  {
   "id": "R09:102EA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそうだねぇ。",
   "en": ""
  },
  {
   "id": "R09:10310",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nん？\n金メダルなら簡単に手に入るぞ。",
   "en": ""
  },
  {
   "id": "R09:10352",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタルとサクヤ：\nえっ？",
   "en": ""
  },
  {
   "id": "R09:1037A",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nこうするんだ。",
   "en": ""
  },
  {
   "id": "R09:103A4",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴトはチケットを使った！\n・・・銀[0227:之]介がやってきた！",
   "en": ""
  },
  {
   "id": "R09:103EE",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "銀之介：\n呼んだだスか？",
   "en": ""
  },
  {
   "id": "R09:10416",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n実は金メダルを売って欲しいのだ。",
   "en": ""
  },
  {
   "id": "R09:10452",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "銀之介：\nまいどー。はい３つ。",
   "en": ""
  },
  {
   "id": "R09:10482",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nき、金メダルも売り物なのぉ？",
   "en": ""
  },
  {
   "id": "R09:104B8",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "銀之介：\nそりゃ欲しい人がいるから、\n売るだスよ。",
   "en": ""
  },
  {
   "id": "R09:104FA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "だってホラ、\nここに３人もいるだス。",
   "en": ""
  },
  {
   "id": "R09:1052E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nでも・・・。",
   "en": ""
  },
  {
   "id": "R09:10554",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "銀之介：\nいらないんだスか？",
   "en": ""
  },
  {
   "id": "R09:10580",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそんなことはないんだけど・・・。",
   "en": ""
  },
  {
   "id": "R09:105BA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "銀之介：\nじゃあ商談成立だスな。",
   "en": ""
  },
  {
   "id": "R09:105EA",
   "font": "R09",
   "kind": "event",
   "end": "A000",
   "jp": "今後ともごひいきに\nお願いするだスよぉー。",
   "en": ""
  },
  {
   "id": "R09:10644",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nどうしたの？",
   "en": ""
  },
  {
   "id": "R09:1066C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nえっ？\nな、何でもないんだ。",
   "en": ""
  },
  {
   "id": "R09:106A4",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nでも、ケガをしていますわ、\n大丈夫ですか？",
   "en": ""
  },
  {
   "id": "R09:106E8",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nありがとう。\nでも、本当に何でもないんだよ。",
   "en": ""
  },
  {
   "id": "R09:10730",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n困ったことなら相談にのるぞ。",
   "en": ""
  },
  {
   "id": "R09:10768",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "何といってもここにいるのは\n救世主ワタルだからな。",
   "en": ""
  },
  {
   "id": "R09:107AC",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nボクは炎部ワタル、よろしくねっ。",
   "en": ""
  },
  {
   "id": "R09:107E6",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "ショタ郎：\nボク、ショタ郎。\nこっちこそよろしくね。",
   "en": ""
  },
  {
   "id": "R09:1082C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "・・・今、いじめられてたのは、\nこのメダルのコトでなんだ。",
   "en": ""
  },
  {
   "id": "R09:10876",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nメダル？",
   "en": ""
  },
  {
   "id": "R09:1089A",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "ショタ郎：\nうん・・・。このメダルは、\nボクが作ったニセモノなんだ。",
   "en": ""
  },
  {
   "id": "R09:10908",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n何と！？",
   "en": ""
  },
  {
   "id": "R09:1092C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "するとこの村では、\n何でもメダルで順位をつけるのか？",
   "en": ""
  },
  {
   "id": "R09:10970",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nメダルがないと\n差別されるなんて・・・。",
   "en": ""
  },
  {
   "id": "R09:109B2",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nうん・・・。",
   "en": ""
  },
  {
   "id": "R09:109DA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ボクの家族は、\nもともとみんな体が弱くて、\nメダルをもらえないんだ。",
   "en": ""
  },
  {
   "id": "R09:10A2E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "お母さんのクスリを買いたいん\nだけど、メダルを持っていないと\nとても高くて買えないんだ。",
   "en": ""
  },
  {
   "id": "R09:10A96",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nそれで、\nニセモノのメダルを作って・・・。",
   "en": ""
  },
  {
   "id": "R09:10ADE",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nイケナイことだって\nわかっていたんだけど、",
   "en": ""
  },
  {
   "id": "R09:10B24",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "クスリを買わなきゃ\nお母さんの病気はよくならないし。\nそれで、ボク・・・。",
   "en": ""
  },
  {
   "id": "R09:10B7E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n運動が得意かどうかだけで",
   "en": ""
  },
  {
   "id": "R09:10BB0",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "すべてが\n決まってしまうなんて・・・。",
   "en": ""
  },
  {
   "id": "R09:10BE6",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nぅうむ・・・許せんなぁ。",
   "en": ""
  },
  {
   "id": "R09:10C1C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nでもいいんだ。",
   "en": ""
  },
  {
   "id": "R09:10C46",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ニセモノのメダルなんかで\n安くものを買おうと思っていた\nボクがいけないんだもん。",
   "en": ""
  },
  {
   "id": "R09:10CA6",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "本物のメダルがもらえるように\nがんばらなくっちゃ。",
   "en": ""
  },
  {
   "id": "R09:10CEA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nワタルくん・・・？",
   "en": ""
  },
  {
   "id": "R09:10D18",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n・・・こんなのおかしいよ！\n間違ってるよ！",
   "en": ""
  },
  {
   "id": "R09:10D5C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "・・・。",
   "en": ""
  },
  {
   "id": "R09:10D74",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nぼうや・・・。",
   "en": ""
  },
  {
   "id": "R09:10D9E",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nワタルさま・・・。",
   "en": ""
  },
  {
   "id": "R09:10DCC",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nショタ郎くん！　待ってて！",
   "en": ""
  },
  {
   "id": "R09:10E00",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ボクがそんなルール、\nブッ壊してあげる！\n絶対に！",
   "en": ""
  },
  {
   "id": "R09:10E42",
   "font": "R09",
   "kind": "event",
   "end": "A000",
   "jp": "ショタ郎：\nワタルくん・・・。",
   "en": ""
  },
  {
   "id": "R09:10E7A",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nわっはっは！\n待っておったぞ救世主ワタル！",
   "en": ""
  },
  {
   "id": "R09:10EBE",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nお前がこの村のルールを\n決めたやつか！！",
   "en": ""
  },
  {
   "id": "R09:10F00",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nそぉーぅだ、私の名前は\n【カール・ジョンソン】！",
   "en": ""
  },
  {
   "id": "R09:10F4A",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "この村のルールは、私が決める！！\nわっはっは！　文句があるなら、\nこのコロッシアムの中で聞こう！",
   "en": ""
  },
  {
   "id": "R09:10FD4",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nわぁーっはっはっは！\nビックリしただろーっ！",
   "en": ""
  },
  {
   "id": "R09:1101A",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "わっはっはっは！",
   "en": ""
  },
  {
   "id": "R09:11054",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nふむぅ、結構時間が\nかかっているな。",
   "en": ""
  },
  {
   "id": "R09:11092",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "これでは\nメダルをやることはできん。",
   "en": ""
  },
  {
   "id": "R09:110C6",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nそれだ。",
   "en": ""
  },
  {
   "id": "R09:110EA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\n何がだ？",
   "en": ""
  },
  {
   "id": "R09:1110C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n何でそんなルールを作るんだ！",
   "en": ""
  },
  {
   "id": "R09:11142",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "困っている人たちだって\nいるんだぞ！\n今すぐやめるんだ！",
   "en": ""
  },
  {
   "id": "R09:1118C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\n私も昔は、人ひとりひとりに\n順位などつけられないのだ、",
   "en": ""
  },
  {
   "id": "R09:111DC",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "みんな同じだ、と思っていた。",
   "en": ""
  },
  {
   "id": "R09:11208",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "だがどうだ！",
   "en": ""
  },
  {
   "id": "R09:11224",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "「自分が一番だ」\n「いいや自分だ」と言って",
   "en": ""
  },
  {
   "id": "R09:1125E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "人びとは勝手に順位をつけたがる！",
   "en": ""
  },
  {
   "id": "R09:1128E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "それならば、\n順位をつけてやろうではないか！",
   "en": ""
  },
  {
   "id": "R09:112CA",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "スポーツに秀でたものがメダルを\n手に入れ、数が多ければ多いほど\nエライ人なのだ、とな！！",
   "en": ""
  },
  {
   "id": "R09:11332",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそんな間違った考えが\n許されるはずがない！",
   "en": ""
  },
  {
   "id": "R09:11376",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそうですわ！",
   "en": ""
  },
  {
   "id": "R09:1139C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "たったひとつのことだけで、\nその人やモノの価値を計るなんて\n間違ってます！",
   "en": ""
  },
  {
   "id": "R09:113F6",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nふむ・・・。",
   "en": ""
  },
  {
   "id": "R09:1141C",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "では\n私が間違っているということを\n証明してもらおう・・・。",
   "en": ""
  },
  {
   "id": "R09:11468",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "この勝負でな！",
   "en": ""
  },
  {
   "id": "R09:11492",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n間違っていることを認めろ！",
   "en": ""
  },
  {
   "id": "R09:114C6",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nう、うむぅ・・・。",
   "en": ""
  },
  {
   "id": "R09:114F2",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "こうなれば、\n【ゴールドメダラー】！",
   "en": ""
  },
  {
   "id": "R09:11544",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "カール：\nワタルさんのおかげで\n目がさめました。",
   "en": ""
  },
  {
   "id": "R09:11584",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "やはり人の優劣なんて\n決められないんですよね。",
   "en": ""
  },
  {
   "id": "R09:115C2",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそうだよ、\n人間いいところもあれば、",
   "en": ""
  },
  {
   "id": "R09:11600",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "悪いところもある。",
   "en": ""
  },
  {
   "id": "R09:11622",
   "font": "R09",
   "kind": "event",
   "end": "3000",
   "jp": "一つの方向から\n見ちゃいけないんだよねっ。",
   "en": ""
  },
  {
   "id": "R09:1165E",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "ショタ郎：\nワタルくん、どうもありがとう。",
   "en": ""
  },
  {
   "id": "R09:11698",
   "font": "R09",
   "kind": "event",
   "end": "2000",
   "jp": "おかげでお母さんの薬が\n買えるようになって、\n具合も良くなってきたんだ。",
   "en": ""
  },
  {
   "id": "R09:116F0",
   "font": "R09",
   "kind": "event",
