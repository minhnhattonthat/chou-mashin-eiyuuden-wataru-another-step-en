{
 "file": "FPRG/R11.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R11:0E682",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nやぁ、教会の鐘が鳴っている。\n誰かが結婚式でもしてるんだな。",
   "en": ""
  },
  {
   "id": "R11:0E6DA",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n結婚かぁ・・・。",
   "en": ""
  },
  {
   "id": "R11:0E704",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ま、全然先の事だし、\nボクには関係ないや。",
   "en": ""
  },
  {
   "id": "R11:0E73E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nあら、ワタルさまも、\nそう大して",
   "en": ""
  },
  {
   "id": "R11:0E778",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "先の事ではないかも\nしれませんわよ。\nうふっ。",
   "en": ""
  },
  {
   "id": "R11:0E7B6",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nえぇ？　何それ？",
   "en": ""
  },
  {
   "id": "R11:0E7E0",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nプ、ぶわぁっはっは！！",
   "en": ""
  },
  {
   "id": "R11:0E812",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "お嬢、\nぼうやに期待をかけすぎですな、\nぶっははははは。",
   "en": ""
  },
  {
   "id": "R11:0E85A",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nもう、おじさまったら！",
   "en": ""
  },
  {
   "id": "R11:0E88A",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "何故こんなときだけ\n察しが良いのです！",
   "en": ""
  },
  {
   "id": "R11:0E8C0",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nくっ、くくく。プ。",
   "en": ""
  },
  {
   "id": "R11:0E8EE",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nもう！",
   "en": ""
  },
  {
   "id": "R11:0E90E",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\n何なのさぁ、２人とも！！",
   "en": ""
  },
  {
   "id": "R11:0E958",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "ワルリーヌ：\nわーたーる、くんっ。",
   "en": ""
  },
  {
   "id": "R11:0E98C",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうわぁおっ！",
   "en": ""
  },
  {
   "id": "R11:0E9B2",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌちゃんじゃないか！\nどうしたの？",
   "en": ""
  },
  {
   "id": "R11:0E9EC",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\nボクね、お姉ちゃんのところに\n行くとこなんだ！",
   "en": ""
  },
  {
   "id": "R11:0EA38",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nふーん、お姉ちゃんは\nどこに住んでいるのかな？",
   "en": ""
  },
  {
   "id": "R11:0EA82",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\nうーんとね、\nこの次の村にいるはずだよっ。",
   "en": ""
  },
  {
   "id": "R11:0EACA",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nへ、へぇ、そ、そうなんだぁ。",
   "en": ""
  },
  {
   "id": "R11:0EB00",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "あの、ワルリーヌちゃん？\nところで、さ・・・。",
   "en": ""
  },
  {
   "id": "R11:0EB3E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nワルリーヌさん。",
   "en": ""
  },
  {
   "id": "R11:0EB68",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "なぜ、ワタルさまにしがみついて\nいらっしゃるのですか？",
   "en": ""
  },
  {
   "id": "R11:0EBAE",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\nふふっ、だって。ボク、\nワタルくんのこと好きだモン。",
   "en": ""
  },
  {
   "id": "R11:0EC00",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "カッコイイし、\nピンチの時に助けてくれたし、\nだーい好き！",
   "en": ""
  },
  {
   "id": "R11:0EC4A",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nふんふんむふ～ん。",
   "en": ""
  },
  {
   "id": "R11:0EC7A",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nワタルさまが\n離れたがっておいでですわ。",
   "en": ""
  },
  {
   "id": "R11:0ECBC",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\nそんなことないよぉ。",
   "en": ""
  },
  {
   "id": "R11:0ECEE",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "だってワタルくんも、\nボクのこと好きだよねぇーっ？",
   "en": ""
  },
  {
   "id": "R11:0ED30",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nえっ、あっ、いや、その・・・。",
   "en": ""
  },
  {
   "id": "R11:0ED68",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\n「好き」、だよね？",
   "en": ""
  },
  {
   "id": "R11:0ED98",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nんーっと、あのぅ・・・。",
   "en": ""
  },
  {
   "id": "R11:0EDCA",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nんふっ、くっくっく、\nどうなんでござるか？",
   "en": ""
  },
  {
   "id": "R11:0EE10",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワ・タ・ルくん？",
   "en": ""
  },
  {
   "id": "R11:0EE30",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nもう！　勝手にしてください！\nわたくしは先に参りますわ！",
   "en": ""
  },
  {
   "id": "R11:0EE84",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\nサクヤちゃん、行っちゃったね。",
   "en": ""
  },
  {
   "id": "R11:0EEC0",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nんふふふふ・・・、\n嫉妬（しっと）しているんだよ。",
   "en": ""
  },
  {
   "id": "R11:0EF0E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\n「しっと」、って・・・何？",
   "en": ""
  },
  {
   "id": "R11:0EF46",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nぼうやとおチビが、自分より\n仲が良さそうなのでくやしいのさ。",
   "en": ""
  },
  {
   "id": "R11:0EF9E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワルリーヌ：\nへぇー。",
   "en": ""
  },
  {
   "id": "R11:0EFC4",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそ、そんなことより、\nサクヤを追いかけないと！",
   "en": ""
  },
  {
   "id": "R11:0F00C",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nんんーっ、そうだな。\nまぁ、ゆっくり行くさ。",
   "en": ""
  },
  {
   "id": "R11:0F06C",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nワタルさまったら、\nあんなにデレデレしてっ！",
   "en": ""
  },
  {
   "id": "R11:0F0B2",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "なぞのこえ：\nそんなにデレデレしてたのかい？",
   "en": ""
  },
  {
   "id": "R11:0F0EE",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nそうですわっ！\n鼻の下をデレーッと伸ばしてっ！",
   "en": ""
  },
  {
   "id": "R11:0F138",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "・・・って、どなたですか？",
   "en": ""
  },
  {
   "id": "R11:0F162",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "なぞのこえ：\nそんなヤツは放っておいて、\nボクと付き合おうよ。",
   "en": ""
  },
  {
   "id": "R11:0F1B2",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nどなたですの？",
   "en": ""
  },
  {
   "id": "R11:0F1DA",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "なぞのこえ：\nさぁ、行こうか！\nボクと一緒に素晴らしい世界へ！",
   "en": ""
  },
  {
   "id": "R11:0F284",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nはっ、わたくしは、一体・・・。\nここは・・・？",
   "en": ""
  },
  {
   "id": "R11:0F2CE",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "なぞのこえ：\nおお！　気がついたんだね！\nマイスィートハニー！",
   "en": ""
  },
  {
   "id": "R11:0F31C",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nはい？",
   "en": ""
  },
  {
   "id": "R11:0F33E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nさぁ、さっそく結婚式を\n行おうじゃないか。",
   "en": ""
  },
  {
   "id": "R11:0F384",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nはい？",
   "en": ""
  },
  {
   "id": "R11:0F3D6",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nあの・・・、\nどちらさまですか？",
   "en": ""
  },
  {
   "id": "R11:0F410",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nまたまたぁ、\nキミのダァーリィンじゃないか。",
   "en": ""
  },
  {
   "id": "R11:0F458",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nはい？",
   "en": ""
  },
  {
   "id": "R11:0F478",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nこれからキミとボクは、\n「結婚」す・る・の♥",
   "en": ""
  },
  {
   "id": "R11:0F4C0",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nえ？　ええーっ！？",
   "en": ""
  },
  {
   "id": "R11:0F50A",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nえ？　え？",
   "en": ""
  },
  {
   "id": "R11:0F52E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "一体何がどうなると、\nあなたとわたくしが結婚する\n事になるのですか？",
   "en": ""
  },
  {
   "id": "R11:0F582",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nもぅ。",
   "en": ""
  },
  {
   "id": "R11:0F5A4",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "キミがボクの城の前をいかにも\n「あなたのお嫁さんにして」って\n感じでウロついてたんじゃないの。",
   "en": ""
  },
  {
   "id": "R11:0F612",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nえ？　あれは別に\nそういうわけでは・・・。",
   "en": ""
  },
  {
   "id": "R11:0F656",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\n直接言うのが恥ずかしいからって、\n城の前をウロウロするなんて、",
   "en": ""
  },
  {
   "id": "R11:0F6B0",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "そんなに\n結婚して欲しかったんだね？\nさ、すぐしよう、今しよう！",
   "en": ""
  },
  {
   "id": "R11:0F700",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nそ、そんな！？",
   "en": ""
  },
  {
   "id": "R11:0F746",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nやめてください！",
   "en": ""
  },
  {
   "id": "R11:0F770",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "あなたと結婚するつもりは\nありませんわ！",
   "en": ""
  },
  {
   "id": "R11:0F7A8",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nささ、そんな事言わずに。",
   "en": ""
  },
  {
   "id": "R11:0F7DC",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "どうせもう鐘は\n９回鳴ってしまった事だし。",
   "en": ""
  },
  {
   "id": "R11:0F816",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nなんですの？\nその９回というのは・・・？",
   "en": ""
  },
  {
   "id": "R11:0F858",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\n鐘が１０回鳴ったら、\nキミはボクの花嫁として",
   "en": ""
  },
  {
   "id": "R11:0F8A0",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "一生過ごす魔法がかかるのさ。",
   "en": ""
  },
  {
   "id": "R11:0F8CC",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "さ、あと１回なったら、\nキミはボクの可愛いお嫁さんだ。",
   "en": ""
  },
  {
   "id": "R11:0F912",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそ、そんな！",
   "en": ""
  },
  {
   "id": "R11:0F938",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "え・・・、あ・・・、\nた、助けて、ワタルさまぁ！",
   "en": ""
  },
  {
   "id": "R11:0F978",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nまだ、\nそんな事を言っているのかい？",
   "en": ""
  },
  {
   "id": "R11:0F9B8",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "そんなワガママなお嫁さんは\nバチが当たっちゃうよ。\nこんな風にね！",
   "en": ""
  },
  {
   "id": "R11:0FA0C",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nキャアァァッッ！",
   "en": ""
  },
  {
   "id": "R11:0FA3E",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "おんなのこのひめい：\nキャアァァッッ！",
   "en": ""
  },
  {
   "id": "R11:0FA74",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nサクヤの声だ！　急ごう！",
   "en": ""
  },
  {
   "id": "R11:0FAAA",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nさ、おとなしくボクと結婚しよう！",
   "en": ""
  },
  {
   "id": "R11:0FAE6",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nい、いや！　いやです！",
   "en": ""
  },
  {
   "id": "R11:0FB16",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ヨメイリ：\nうふぅーん、\nそんな事言わずにぃ。",
   "en": ""
  },
  {
   "id": "R11:0FB54",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "さぁ、\n誓（ちか）いのキッスを・・・。",
   "en": ""
  },
  {
   "id": "R11:0FB8A",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nいやぁぁっっ！！",
   "en": ""
  },
  {
   "id": "R11:0FBB6",
   "font": "R11",
   "kind": "event",
   "end": "4000",
   "jp": "何て声をかけようかな？\n１．サクヤを放せ！\n２．ボクもまぜろ！",
   "en": ""
  },
  {
   "id": "R11:0FC06",
   "font": "R11",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nサクヤを放せ！",
   "en": ""
  },
  {
   "id": "R11:0FC2E",
   "font": "R11",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nお嬢を放すんだ！",
   "en": ""
  },
  {
   "id": "R11:0FC5C",
   "font": "R11",
