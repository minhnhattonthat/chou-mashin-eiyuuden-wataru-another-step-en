  },
  {
   "id": "R00:0D066",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "それでね・・・",
   "en": ""
  },
  {
   "id": "R00:0D084",
   "font": "R00",
   "kind": "event",
   "end": "3000",
   "jp": "オババ：\nだぁーっ！！",
