   "en": ""
  },
  {
   "id": "R00:0D0D2",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "オババ：\nおまえの名前は、\nなんというんじゃっ！！",
   "en": ""
  },
  {
   "id": "R00:0D114",
   "font": "R00",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nほ、炎部（ほむらべ）ワタル。",
