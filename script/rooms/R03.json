{
 "file": "FPRG/R03.BIN",
 "base": "800CE000",
 "entries": [
  {
   "id": "R03:0E32A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nあっ、次の村が見えてきたよ！！",
   "en": ""
  },
  {
   "id": "R03:0E362",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそのようでございますわね。",
   "en": ""
  },
  {
   "id": "R03:0E396",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：[B000]明\nうーむ、何か爆発が\n起こっているようではないか？",
   "en": ""
  },
  {
   "id": "R03:0E3EA",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "なぞのこえ：\nよーし、やれっ！",
   "en": ""
  },
  {
   "id": "R03:0E41A",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "村人：\nうわぁー。",
   "en": ""
  },
  {
   "id": "R03:0E43E",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "村人：\nたすけてー。",
   "en": ""
  },
  {
   "id": "R03:0E464",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nきゃあー。",
   "en": ""
  },
  {
   "id": "R03:0E486",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nうっわぁー、すっげぇー。",
   "en": ""
  },
  {
   "id": "R03:0E4B8",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n本当に家が爆発していますわ。",
   "en": ""
  },
  {
   "id": "R03:0E4EE",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nいやぁ、\nリアリティにあふれているなぁ。",
   "en": ""
  },
  {
   "id": "R03:0E534",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\n今、何と言ったのかね？",
   "en": ""
  },
  {
   "id": "R03:0E56A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nいやぁ、リアリティがあるなぁと。",
   "en": ""
  },
  {
   "id": "R03:0E5A6",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nそうか！",
   "en": ""
  },
  {
   "id": "R03:0E5CE",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "うんうん、キミは特撮のことが\nよくわかっているようだね。",
   "en": ""
  },
  {
   "id": "R03:0E616",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "やはり特撮は\n本物を使わんとイカンな。",
   "en": ""
  },
  {
   "id": "R03:0E64E",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nしかし、あのエキストラの人たち\nも大変ですなぁ。",
   "en": ""
  },
  {
   "id": "R03:0E69A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nまるで\n本当に[0212:救]われているようですわ。",
   "en": ""
  },
  {
   "id": "R03:0E6DA",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n大した演技力だね。",
   "en": ""
  },
  {
   "id": "R03:0E706",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nいや、\nあれはリアリティを出すために",
   "en": ""
  },
  {
   "id": "R03:0E74A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人を本当に[0212:救]っているんだ。",
   "en": ""
  },
  {
   "id": "R03:0E776",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタルたち：\nい！？",
   "en": ""
  },
  {
   "id": "R03:0E79A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nうんうん、特撮のリアリティと\nいうのは、こうじゃなくっちゃ。",
   "en": ""
  },
  {
   "id": "R03:0E7F6",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nでも本物っぽさを出すために\n罪もないヒトを傷つけるのは",
   "en": ""
  },
  {
   "id": "R03:0E846",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "良くないよ。",
   "en": ""
  },
  {
   "id": "R03:0E862",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nワタルさまの\nおっしゃる通りですわ。",
   "en": ""
  },
  {
   "id": "R03:0E8A2",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nそうか・・・。",
   "en": ""
  },
  {
   "id": "R03:0E8D0",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "どうやら君たちには\n本当の映像の良さが\nわからないようだ。",
   "en": ""
  },
  {
   "id": "R03:0E91A",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "まあ、文句があるなら\nいつでも言いにきたまえ。\nまた会おう。",
   "en": ""
  },
  {
   "id": "R03:0E968",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "モロ・モロＱ：\n撤収ーっ！",
   "en": ""
  },
  {
   "id": "R03:0E994",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n間違ってると思う。",
   "en": ""
  },
  {
   "id": "R03:0E9C0",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\n拙も同意見だ。",
   "en": ""
  },
  {
   "id": "R03:0E9EC",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\n大丈夫ですか？",
   "en": ""
  },
  {
   "id": "R03:0EA14",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "村人：\nう・・・うう・・・。",
   "en": ""
  },
  {
   "id": "R03:0EA46",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nなぁ、あんた達、\n救世主なんじゃろ？",
   "en": ""
  },
  {
   "id": "R03:0EA82",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそうですわ。",
   "en": ""
  },
  {
   "id": "R03:0EAA8",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\n村々を\n平和に導いてくれるっちゅー。",
   "en": ""
  },
  {
   "id": "R03:0EAE4",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nそうだな。",
   "en": ""
  },
  {
   "id": "R03:0EB0A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nじゃあ、あの【モロ・モロＱ】を\n何とかしてくれんかの。",
   "en": ""
  },
  {
   "id": "R03:0EB58",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nそうですよね、いくら\n本物らしさを出したいからって、",
   "en": ""
  },
  {
   "id": "R03:0EBA6",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村のヒトを傷つけるなんて\n許せないよ。",
   "en": ""
  },
  {
   "id": "R03:0EBDC",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nそうなんじゃ、\nワシらもノリは大好きなんじゃが、",
   "en": ""
  },
  {
   "id": "R03:0EC24",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ヒーローが出てきて\n助けてくれないんじゃ、\nヤル気がしないんじゃ。",
   "en": ""
  },
  {
   "id": "R03:0EC76",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nは？",
   "en": ""
  },
  {
   "id": "R03:0EC94",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nやっぱヒーローが助けてくれんと、\n何かこう、",
   "en": ""
  },
  {
   "id": "R03:0ECD8",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ファイトが出ないというか・・・。",
   "en": ""
  },
  {
   "id": "R03:0ED08",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nは？",
   "en": ""
  },
  {
   "id": "R03:0ED26",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nなあ、みんな。",
   "en": ""
  },
  {
   "id": "R03:0ED4C",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nはぁ・・・。",
   "en": ""
  },
  {
   "id": "R03:0ED72",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nそこでじゃ、",
   "en": ""
  },
  {
   "id": "R03:0ED96",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "あんた達に\n【超おもしろカッコいい隊】に\nなって欲しいんじゃ。",
   "en": ""
  },
  {
   "id": "R03:0EDE4",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nはぁ？",
   "en": ""
  },
  {
   "id": "R03:0EE04",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nそうじゃそうじゃ！\n【超おもしろカッコいい隊】じゃ！",
   "en": ""
  },
  {
   "id": "R03:0EE50",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nワシらのヒーローの誕生じゃ！",
   "en": ""
  },
  {
   "id": "R03:0EE84",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\n・・・と言うわけで、\nやってくださるな？",
   "en": ""
  },
  {
   "id": "R03:0EEC4",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nど、どうしよう。",
   "en": ""
  },
  {
   "id": "R03:0EEEE",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nここの方々も、かなり変わった\n人達のようですわね。",
   "en": ""
  },
  {
   "id": "R03:0EF3A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nぼうや、おもしろそうじゃないか。",
   "en": ""
  },
  {
   "id": "R03:0EF76",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nええーっ、やるのぉ？",
   "en": ""
  },
  {
   "id": "R03:0EFA4",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n「郷に入っては郷に従え」と\nいうしな。",
   "en": ""
  },
  {
   "id": "R03:0EFE6",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nそのことわざは、\nこの場合は意味が・・・。",
   "en": ""
  },
  {
   "id": "R03:0F02A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nよし、やってみよう！",
   "en": ""
  },
  {
   "id": "R03:0F058",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nワタルさま！",
   "en": ""
  },
  {
   "id": "R03:0F07E",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n村のヒトが納得するなら。\nそうしようよ。",
   "en": ""
  },
  {
   "id": "R03:0F0C0",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nよし決まった！　善は急げだ！",
   "en": ""
  },
  {
   "id": "R03:0F0F8",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\n・・・と、言うわけで、",
   "en": ""
  },
  {
   "id": "R03:0F126",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "まず、コサクさんに\nカッコいい隊の衣装を\nお願いしてくるのじゃ。",
   "en": ""
  },
  {
   "id": "R03:0F176",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nコサクさんって、\nどこにいるの？",
   "en": ""
  },
  {
   "id": "R03:0F1B0",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\n村の入り口近くの家じゃな。",
   "en": ""
  },
  {
   "id": "R03:0F1E2",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "そこで、衣装をお願いしたら、\n村の興にある家で\n布をもらってきて・・・。",
   "en": ""
  },
  {
   "id": "R03:0F23A",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n衣装にしてもらえばいいんだね？",
   "en": ""
  },
  {
   "id": "R03:0F272",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nそうじゃ。",
   "en": ""
  },
  {
   "id": "R03:0F294",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "んで、衣装ができたら、\n村の興にある採石場へ行って、",
   "en": ""
  },
  {
   "id": "R03:0F2D8",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\n【モロ・モロＱ】と対決！　だな。",
   "en": ""
  },
  {
   "id": "R03:0F314",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "村人：\nそうじゃ。",
   "en": ""
  },
  {
   "id": "R03:0F336",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "じゃっ、がんばってくだされ、\n【超おもしろカッコいい隊】よ！",
   "en": ""
  },
  {
   "id": "R03:0F39C",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nとうとうやって来たね、【超\nおもしろカッコいい隊】の諸君。",
   "en": ""
  },
  {
   "id": "R03:0F3F6",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nなぜそのことを・・・！",
   "en": ""
  },
  {
   "id": "R03:0F426",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nそういう楽しそうなシナリオが、\nボクの耳に入らないと思うかい？",
   "en": ""
  },
  {
   "id": "R03:0F484",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "アラゴト：\nさては村人みんなグルだったな？",
   "en": ""
  },
  {
   "id": "R03:0F4C0",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nチッチッチ。\nグルだなんて人聞きの悪い。",
   "en": ""
  },
  {
   "id": "R03:0F508",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "みんな最高の映像を\n撮りたいだけなのさ。",
   "en": ""
  },
  {
   "id": "R03:0F540",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\nちがう！\nそんな考えは間違っている！",
   "en": ""
  },
  {
   "id": "R03:0F57E",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nそうだ！\nヒトの幸せをむしばむ悪人め！",
   "en": ""
  },
  {
   "id": "R03:0F5C0",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ゆ・る・さ・ん！",
   "en": ""
  },
  {
   "id": "R03:0F5E0",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "サクヤ：\nなんだかんだ言って、\nお二人ともハマってますわ。",
   "en": ""
  },
  {
   "id": "R03:0F62C",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "モロ・モロＱ：\nはぁーっはっはっは！　こい！\n【超おもしろカッコいい隊】よ！",
   "en": ""
  },
  {
   "id": "R03:0F688",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "ワタル：\n望むところだ！　行くぞ！",
   "en": ""
  },
  {
   "id": "R03:0F6BA",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "アラゴト：\nおう！",
   "en": ""
  },
  {
   "id": "R03:0F6DC",
   "font": "R02",
   "kind": "event",
   "end": "2000",
   "jp": "サクヤ：\nお、おう・・・。",
   "en": ""
  },
  {
   "id": "R03:0F706",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "ワタル：\nへっぽこチェンジ！\n【超おもしろカッコいい隊】！",
   "en": ""
  },
  {
   "id": "R03:0F752",
   "font": "R02",
   "kind": "event",
   "end": "3000",
   "jp": "モロ・モロＱ：\n行け！\n「魔神獣【ＳＦＸザウルス】」よ！",
   "en": ""
  },
  {
   "id": "R03:0F7A6",
   "font": "R02",
