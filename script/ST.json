{
 "file": "PRG/ST.BIN",
 "base": "800D0000",
 "entries": [
  {
   "id": "ST:00104",
   "kind": "menu",
   "jp": "　バトルをつづける\n　リトライ\n　ギブアップ",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00134",
   "kind": "menu",
   "jp": "勝負だ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00140",
   "kind": "menu",
   "jp": "勝負よ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00174",
   "kind": "menu",
   "jp": "バトルの説明をしよう！\n　　　はい\n　　　いいえ",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:001A8",
   "kind": "menu",
   "jp": "バトルの説明をするわよ！\n　　　はい\n　　　いいえ",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00204",
   "kind": "menu",
   "jp": "なに！？　説明を聞かないのか？",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00224",
   "kind": "menu",
   "jp": "え！？　説明を聞かないの？",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00264",
   "kind": "menu",
   "jp": "後でこうかいしても、\nしらないぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00288",
   "kind": "menu",
   "jp": "後でこうかいしても、\nしらないわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:002D4",
   "kind": "menu",
   "jp": "と、まあ説明はこんなもんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:002F4",
   "kind": "menu",
   "jp": "と、まあ説明はこんなものね！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0033C",
   "kind": "menu",
   "jp": "わかったか？\n　　　はい\n　　　いいえ",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00364",
   "kind": "menu",
   "jp": "わかったかしら？\n　　　はい\n　　　いいえ",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:003B4",
   "kind": "menu",
   "jp": "はじめからやり直すのか？",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:003D0",
   "kind": "menu",
   "jp": "はじめからやり直すの？",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0040C",
   "kind": "menu",
   "jp": "なん度でも、受けて立つぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00428",
   "kind": "menu",
   "jp": "なん度でも、受けて立つわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0046C",
   "kind": "menu",
   "jp": "だがこの後には、\nもっと手ごわいバトルが\nまっているぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:004A8",
   "kind": "menu",
   "jp": "でもこの後には、\nもっと手ごわいバトルが\nまっているわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0050C",
   "kind": "menu",
   "jp": "お前のその勇気で、\n立ち向かってくれ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00534",
   "kind": "menu",
   "jp": "あなたのその勇気で、\n立ち向かうことね！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00584",
   "kind": "menu",
   "jp": "ＩＱバトルスタート！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:005C4",
   "kind": "menu",
   "jp": "・・・と、その前に、",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00604",
   "kind": "menu",
   "jp": "ちなみに、\nこのバトルには、\nギブアップがないぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00638",
   "kind": "menu",
   "jp": "ちなみに、\nこのバトルには、\nギブアップがないわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00694",
   "kind": "menu",
   "jp": "心してかかれ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:006A4",
   "kind": "menu",
   "jp": "心してかかりなさい！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:006E4",
   "kind": "menu",
   "jp": "よーく聞いておくんだぞ。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00700",
   "kind": "menu",
   "jp": "よーく聞いておきなさいよ。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00744",
   "kind": "menu",
   "jp": "なに！？\n説明を聞いてなかったのか？",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0076C",
   "kind": "menu",
   "jp": "なに！？\n説明を聞いてなかったの？",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:007B4",
   "kind": "menu",
   "jp": "まったく、こまったやつだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:007D0",
   "kind": "menu",
   "jp": "まったく、こまったやつね！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00814",
   "kind": "menu",
   "jp": "どうしても、できない場合は、\nこうさんしてもいいぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0084C",
   "kind": "menu",
   "jp": "どうしても、できない場合は、\nこうさんしてもいいわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:008AC",
   "kind": "menu",
   "jp": "バトル中に、\nスタートボタンを押すんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:008D8",
   "kind": "menu",
   "jp": "バトル中に、\nスタートボタンを押すの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00924",
   "kind": "menu",
   "jp": "すると、\nウィンドウが表示されるんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0094C",
   "kind": "menu",
   "jp": "すると、\nウィンドウが表示されるわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0099C",
   "kind": "menu",
   "jp": "もう一度、\nはじめからやり直す場合は、\nリトライを選択するんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:009E0",
   "kind": "menu",
   "jp": "もう一度、\nはじめからやり直す場合は、\nリトライを選択するの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00A44",
   "kind": "menu",
   "jp": "こうさんする場合は、\nギブアップを選択するんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00A78",
   "kind": "menu",
   "jp": "こうさんする場合は、\nギブアップを選択するの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00ACC",
   "kind": "menu",
   "jp": "やっぱり、バトルをつづける\nという場合は、バトルをつづける\nを選択するんだ。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00B1C",
   "kind": "menu",
   "jp": "やっぱり、バトルをつづける\nという場合は、バトルをつづける\nを選択するの。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00B8C",
   "kind": "menu",
   "jp": "方向キーの、\n上と下で選択できるぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00BB4",
   "kind": "menu",
   "jp": "方向キーの、\n上と下で選択できるわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00C04",
   "kind": "menu",
   "jp": "だいじな選択だから、\nよく考えて決めるように！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00C34",
   "kind": "menu",
   "jp": "だいじな選択だから、\nよく考えて決めるようにね！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00C8C",
   "kind": "menu",
   "jp": "決定は○ボタンだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00CA0",
   "kind": "menu",
   "jp": "決定は○ボタンよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00CDC",
   "kind": "menu",
   "jp": "よし、このイラストを\nよーく見て、\nしっかりとおぼえるんだ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00D1C",
   "kind": "menu",
   "jp": "じゃあ、このイラストを\nよーく見て、\nしっかりとおぼえるのよ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00DAC",
   "kind": "menu",
   "jp": "このバトルは、パズルゲームだ。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00DCC",
   "kind": "menu",
   "jp": "このバトルは、パズルゲームよ。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00E14",
   "kind": "menu",
   "jp": "バラバラになっているイラストを、\nうまく完成させるとクリアだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00E54",
   "kind": "menu",
   "jp": "バラバラになっているイラストを、\nうまく完成させるとクリアよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00EBC",
   "kind": "menu",
   "jp": "パネルは、\nカーソルで選択して動かせるぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00EE8",
   "kind": "menu",
   "jp": "パネルは、\nカーソルで選択して動かせるわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00F3C",
   "kind": "menu",
   "jp": "カーソルは、\nコントローラの\n方向キーで動かすんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00F74",
   "kind": "menu",
   "jp": "カーソルは、コントローラの\n方向キーで動かすの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00FCC",
   "kind": "menu",
   "jp": "上、下、左、右の４方向に動くぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:00FF0",
   "kind": "menu",
   "jp": "上、下、左、右の４方向に動くわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0103C",
   "kind": "menu",
   "jp": "でも、動かせないパネルには、\nカーソルは動かせないぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01074",
   "kind": "menu",
   "jp": "でも、動かせないパネルには、\nカーソルは動かせないわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:010D4",
   "kind": "menu",
   "jp": "ブザーが、なるんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:010EC",
   "kind": "menu",
   "jp": "ブザーが、なるの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01124",
   "kind": "menu",
   "jp": "動かすパネルを選択したら、\n○ボタンで決定だ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01154",
   "kind": "menu",
   "jp": "動かすパネルを選択したら、\n○ボタンで決定よ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:011AC",
   "kind": "menu",
   "jp": "決定したパネルは、\n自動で動くぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:011D0",
   "kind": "menu",
   "jp": "決定したパネルは、\n自動で動くわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0121C",
   "kind": "menu",
   "jp": "こんな感じで、\nイラストをくみ立てていくんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0124C",
   "kind": "menu",
   "jp": "こんな感じで、\nイラストをくみ立てていくの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:012A4",
   "kind": "menu",
   "jp": "はっはっはっ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:012DC",
   "kind": "menu",
   "jp": "こんなパズルもできないぼうやが\nこの私に勝とうなんて、\nおかしすぎるな！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01328",
   "kind": "menu",
   "jp": "こんなパズルもできないぼうやが\nこの私に勝とうなんて、\nおかしすぎるわね！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0139C",
   "kind": "menu",
   "jp": "私にかかれば、こんなパズル・・・",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:013E4",
   "kind": "menu",
   "jp": "わっはっはっ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:013F4",
   "kind": "menu",
   "jp": "あっはっはっ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0142C",
   "kind": "menu",
   "jp": "ハッ！　できてるぞ！？\n思わず完成させてしまったが、\n負けは負けだ・・・。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01478",
   "kind": "menu",
   "jp": "ハッ！　できてるわ！？\n思わず完成させてしまったけど、\n負けは負けね・・・。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:014EC",
   "kind": "menu",
   "jp": "負けちまったのだぁぁぁぁぁぁ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01510",
   "kind": "menu",
   "jp": "負けちゃったのねぇぇぇぇぇぇ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0155C",
   "kind": "menu",
   "jp": "ふはははは！\nなかなかやるではないか。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01584",
   "kind": "menu",
   "jp": "あはははは！\nなかなかやるじゃない。",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:015D4",
   "kind": "menu",
   "jp": "バラバラになっている\nイラストは、\nパネルというんだ！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01610",
   "kind": "menu",
   "jp": "バラバラになっている\nイラストは、\nパネルというの！！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0166C",
   "kind": "menu",
   "jp": "このバトルは、カードゲームだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:0168C",
   "kind": "menu",
   "jp": "このバトルは、カードゲームよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:016D4",
   "kind": "menu",
   "jp": "裏になっている３まいのカードの、\nばしょと種類を当てるとクリアだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01718",
   "kind": "menu",
   "jp": "裏になっている３まいのカードの、\nばしょと種類を当てるとクリアよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01784",
   "kind": "menu",
   "jp": "カードは、９種類あって、\n１から９までの数字とイラストが、\nかいてあるんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:017D4",
   "kind": "menu",
   "jp": "カードは９種類あって、\n１から９までの数字とイラストが\nかいてあるの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01844",
   "kind": "menu",
   "jp": "カードは、\nカーソルを合わせてかえられるぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01874",
   "kind": "menu",
   "jp": "カードは、\nカーソルを合わせてかえられるわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:018CC",
   "kind": "menu",
   "jp": "カーソルは、\nコントローラの\n方向キーで動かすの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01924",
   "kind": "menu",
   "jp": "左、右の２方向に動くぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01940",
   "kind": "menu",
   "jp": "左、右の２方向に動くわ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01984",
   "kind": "menu",
   "jp": "かえたいカードに、\nカーソルを合わせるんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:019B4",
   "kind": "menu",
   "jp": "かえたいカードに、\nカーソルを合わせるの！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01A04",
   "kind": "menu",
   "jp": "カードをかえるときは、\n方向キーの上、下で選択するんだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01A40",
   "kind": "menu",
   "jp": "カードをかえるときは、\n方向キーの上、下で選択するのよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01AA4",
   "kind": "menu",
   "jp": "そして、○ボタンで決定だ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01AC0",
   "kind": "menu",
   "jp": "そして、○ボタンで決定よ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01B04",
   "kind": "menu",
   "jp": "×ボタンで\nキャンセルもできるぞ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01B28",
   "kind": "menu",
   "jp": "×ボタンで\nキャンセルもできるわよ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01B74",
   "kind": "menu",
   "jp": "３まいのカードを決定したら、\n１ターンおしまいだ！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01BA8",
   "kind": "menu",
   "jp": "３まいのカードを決定したら、\n１ターンおしまい！",
   "en": "",
   "end": "FFFF"
  },
  {
   "id": "ST:01C04",
   "kind": "menu",
   "jp": "１ターンがおわって、\nカードのばしょが\n当たっているときは、",
   "en": "",
   "end": "FFFF"
  },
  {
